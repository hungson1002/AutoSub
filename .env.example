# Flow Agent backend used by AI Video Studio.
FLOW_AGENT_URL=http://127.0.0.1:8001

# Only needed when SERVER_API_KEY is enabled in Flow Agent.
# FLOW_AGENT_API_KEY=

# Optional exact Flow URL from the signed-in tab (preserves its /u/N/ account).
# Startup fallback only; a connected browser's selected Flow account takes precedence.
# FLOW_GOOGLE_URL=https://flow.google.com/u/2/
# Optional account slot when FLOW_GOOGLE_URL is unset.
# FLOW_GOOGLE_AUTHUSER=1
# Optional when the Flow Agent executable is installed in a custom location.
# FLOW_AGENT_EXECUTABLE=C:\path\to\flow.exe

# AI film production tuning (credit-safe defaults).
# Up to three no-charge transport retries are always used; creative retakes stay at one by default.
# AUTOSUB_VISUAL_QUALITY_ATTEMPTS=1
# AUTOSUB_STORYBOARD_CONCURRENCY=3
# AUTOSUB_VIDEO_SHOT_CONCURRENCY=2
# Animation Studio Turbo: image workers ramp up/down automatically up to this ceiling.
# Flow Agent uses a conservative default ceiling of 3 because one browser bridge
# becomes less reliable under bursty concurrency; other providers default to 4.
# AUTOSUB_ANIMATION_IMAGE_CONCURRENCY=3
# Extra Flow-side stability guard: no more than two image requests are allowed
# through the local browser bridge at once, staggered by ~2.5 seconds.
# AUTOSUB_FLOW_IMAGE_PARALLELISM=2
# AUTOSUB_FLOW_IMAGE_START_GAP_MS=2500
# Animation Studio voiceover generation is parallelized while preserving sentence order.
# CapCut TTS is automatically kept at 1 and local VieNeu at 2.
# AUTOSUB_ANIMATION_TTS_CONCURRENCY=6
# Credit-free wait after a Flow image request times out (milliseconds).
# AUTOSUB_FLOW_IMAGE_RECOVERY_WAIT_MS=60000

# Optional when Opera GX is installed outside its default LocalAppData location.
# OPERA_PATH=C:\Users\<you>\AppData\Local\Programs\Opera GX\opera.exe

# Review: bounded parallel TTS/render work; preserves output order and encoding quality.
# AUTOSUB_REVIEW_CONCURRENCY=3
# Total video encoder thread budget, shared by concurrent review scenes.
# AUTOSUB_REVIEW_THREADS=8

# Performance tuning for an 8-core / 16-thread workstation. Defaults already
# use these safe values; override only if a provider rate-limits requests.
# AUTOSUB_GROQ_STT_CONCURRENCY=3
# AUTOSUB_OCR_CONCURRENCY=6
# AUTOSUB_TIMELINE_CONCURRENCY=4
# AUTOSUB_WHISPER_THREADS=4
# Local STT runs below normal priority by default to keep the UI responsive.
# AUTOSUB_BACKGROUND_PRIORITY=1
# Comma-separated local models to hide and prevent automatic re-download on this machine.
# AUTOSUB_STT_DISABLED_MODELS=qwen3-asr-0.6b,qwen3-asr-1.7b,funasr-nano-2512

# FunASR Local (Chinese-first STT). Default runtime is isolated CPU Python.
# Point AUTOSUB_FUNASR_PYTHON at your own CUDA-enabled Python to use NVIDIA GPU.
# AUTOSUB_FUNASR_THREADS=4
# AUTOSUB_FUNASR_DEVICE=auto
# AUTOSUB_FUNASR_PYTHON=C:\\path\\to\\python.exe

# Qwen3-ASR Local. Default isolated runtime uses CPU.
# For NVIDIA GPU, point AUTOSUB_QWEN3_ASR_PYTHON to a CUDA-enabled env with qwen-asr.
# AUTOSUB_QWEN3_ASR_THREADS=4
# AUTOSUB_QWEN3_ASR_DEVICE=auto
# AUTOSUB_QWEN3_ASR_PYTHON=C:\\path\\to\\python.exe

# ZeroTTS Local Vietnamese quality preset. ONNX CPU; model downloads once from Hugging Face.
# AUTOSUB_ZEROTTS_THREADS=8
# AUTOSUB_ZEROTTS_IDLE_TIMEOUT_MS=600000
# AUTOSUB_ZEROTTS_PYTHON=C:\\path\\to\\python.exe
