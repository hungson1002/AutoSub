# Flow Agent backend used by AI Video Studio.
FLOW_AGENT_URL=http://127.0.0.1:8001

# Only needed when SERVER_API_KEY is enabled in Flow Agent.
# FLOW_AGENT_API_KEY=

# Optional when the Flow Agent executable is installed in a custom location.
# FLOW_AGENT_EXECUTABLE=C:\path\to\flow.exe

# Optional when Opera GX is installed outside its default LocalAppData location.
# OPERA_PATH=C:\Users\<you>\AppData\Local\Programs\Opera GX\opera.exe
